CREATE TABLE items (
    id TEXT NOT NULL PRIMARY KEY,
    item_name TEXT NOT NULL,
    report_type TEXT NOT NULL,
    category TEXT NOT NULL,
    description TEXT NOT NULL,
    location TEXT NOT NULL,
    date_found TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT 'AVAILABLE',
    user_id TEXT,
    sync_status TEXT NOT NULL DEFAULT 'PENDING'
);

selectAllItems:
SELECT *
FROM items
ORDER BY created_at DESC;

insertItem:
INSERT INTO items (
    id,
    item_name,
    report_type,
    category,
    description,
    location,
    date_found,
    created_at,
    status,
    user_id,
    sync_status
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllItems:
DELETE FROM items;

CREATE TABLE claims (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    claimant_id TEXT,
    claim_reason TEXT NOT NULL,
    identifying_details TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'PENDING',
    created_at TEXT NOT NULL DEFAULT '',
    FOREIGN KEY (item_id) REFERENCES items(id)
);

insertClaim:
INSERT INTO claims (
    id,
    item_id,
    claimant_id,
    claim_reason,
    identifying_details,
    status,
    created_at
)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllClaims:
SELECT *
FROM claims
ORDER BY created_at DESC;

selectClaimsByItem:
SELECT *
FROM claims
WHERE item_id = ?
ORDER BY created_at DESC;

updateClaimStatus:
UPDATE claims
SET status = ?
WHERE id = ?;

updateItemStatus:
UPDATE items
SET status = ?
WHERE id = ?;

rejectOtherPendingClaims:
UPDATE claims
SET status = 'REJECTED'
WHERE item_id = ?
AND id != ?
AND status = 'PENDING';
